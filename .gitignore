# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Auto-generated by setuptools-scm (tool.setuptools_scm.version_file) — git-derived,
# never hand-edited or committed.
/_lw_version.py
# Baked by loreweaver-server.spec at PyInstaller build time (frozen --version sidecar).
/VERSION

# Launch/press kit + personal career notes — private drafts, never published via git.
promo/

# --- Secrets & runtime data (NEVER commit) ---
.env
.env.*
!.env.example
# databases + runtime state
*.db
*.sqlite
*.sqlite3
data/
shared/
# issued keys / host keys (only the *.example.* files are committed)
**/keys.toml
**/tui_keys.toml
**/ssh_keys.toml
*_host_key
*_host_key.pub
*.pem
!**/*.example.toml

# --- Node / clients ---
node_modules/
clients/*/dist/
*.tsbuildinfo
.vite/
coverage/
.bun/

# --- Internal (not published: design specs + build blueprint) ---
# `/*` instead of `/` so single specs can be re-included below (git cannot
# negate a path inside an excluded DIRECTORY, only inside an excluded glob).
docs/specs/*
# Deliberately public (owner 2026-08-13): the first spec published under the
# docs/notes decision-record discipline it institutes. Everything else in
# docs/specs/ stays internal — flagship/playtest material must never ship.
!docs/specs/M23-harness-resilience.md
PROMPT.md

# --- Local play-test material (user-supplied modules / cards; may be copyrighted) ---
modules/
playtest/
cards/

# --- Module sources: unreleased flagship + example modules. NEVER publish from here.
# (2026-08-10: a broad `git add` swept these into a public commit; the history was
#  rewritten to purge them. The rule below is what stops it happening again.)
content/

# Built packs land in the CWD by default — never commit a build artifact.
*.lwpack

# --- Misc ---
.DS_Store
*.log
scratch/

# TUI preview render artifact
clients/tui/preview_frame.txt

# local-only play launcher that loads private module/card material (not for the public repo)
scripts/play_tui.sh
.prompts/

# local AI-session state written by external tooling (never publish)
.omo/

# live behavioral-eval transcripts and summaries (local evidence, never publish)
eval-logs/

# hostLocal test artifacts (clients/tui bun test spins a local server at repo root)
.keys.toml.lock
iroh-secret.key
iroh-ticket.txt

# --- 《安土》 marketing footage (generated video/stills for the trailer; never publish from here)
marketing/
