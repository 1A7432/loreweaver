{
  "name": "loreweaver-protocol",
  "version": "3.0.0",
  "description": "The Loreweaver wire protocol 3.0 for clients: typed frames and views, a decoder for what a server sends, and a transport-agnostic client session. Loreweaver is a self-hosted AI Game Master / Keeper for tabletop RPGs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1A7432/loreweaver.git",
    "directory": "clients/protocol"
  },
  "homepage": "https://github.com/1A7432/loreweaver#readme",
  "bugs": {
    "url": "https://github.com/1A7432/loreweaver/issues"
  },
  "keywords": [
    "loreweaver",
    "ttrpg",
    "ai-game-master",
    "coc",
    "dnd",
    "protocol",
    "iroh"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v3": {
      "bun": "./src/v3/index.ts",
      "types": [
        "./dist/v3/index.d.ts",
        "./src/v3/index.ts"
      ],
      "default": "./dist/v3/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "tsc --noEmit -p tsconfig.build.json && bun test",
    "prepublishOnly": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
