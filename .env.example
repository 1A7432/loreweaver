# --- LLM (OpenAI-compatible + native anthropic/gemini) ---
# PROVIDER picks a base_url preset (openai/deepseek/groq/openrouter/together/ollama/lmstudio/...
# or anthropic/gemini). `chatgpt` / `gpt-subscription` are dual-mode: leave
# BASE_URL blank after `.model login chatgpt` for subscription OAuth, or set it
# to an OpenAI-compatible gateway for the classic proxy + API-key path.
# `supergrok` always uses the grant obtained by `.model login supergrok`.
TRPG_LLM__PROVIDER=deepseek
TRPG_LLM__API_KEY=sk-...
# TRPG_LLM__BASE_URL=https://proxy.example/v1
# A capable Keeper matters: strong models run the module's own scenes and roll dice via the
# tools; budget models (e.g. a *-flash tier) drift off-module and narrate without rolling.
TRPG_LLM__CHAT_MODEL=deepseek-v4-pro
# DeepSeek thinking mode: "high" (default depth) or "max" (hardest reasoning). Blank = off /
# non-reasoning model. Do NOT set a temperature alongside it — thinking mode ignores temperature
# and a low value degrades the reasoning trace; omit it entirely and the provider uses its default.
TRPG_LLM__REASONING_EFFORT=max
# Context window in tokens. Blank/0 = detect from the model name, which is right for the
# families infra/llm.py knows. Set it for anything else: this number is the DENOMINATOR of
# the chronicle fold (0.60 trigger / 0.40 floor / 0.85 emergency), so an under-reported
# window makes a room summarise and trim its raw transcript long before it needs to.
# TRPG_LLM__CONTEXT_WINDOW=1000000
# Ask an OpenAI-compatible endpoint to report token usage on STREAMING replies
# (`stream_options.include_usage`, part of the OpenAI Chat Completions API and
# documented the same way by DeepSeek and Moonshot). Leave it on: a streamed turn
# reports NOTHING without it, and that meter is what triggers the chronicle fold —
# a room that never reports never trims. Set it false only for an endpoint that
# rejects the parameter; the room then falls back to an estimated meter.
# TRPG_LLM__STREAM_USAGE=false
TRPG_LLM__EMBEDDING_MODEL=text-embedding-3-small
TRPG_LLM__EMBEDDING_DIM=1536
# (Chat-only providers with no embeddings endpoint fall back to a local hash embedder automatically.)
# PRIVACY BOUNDARY: a remote LLM receives module text, keeper-only lore, relevant history, and
# current player input. The standard app uses local hash embeddings; an explicitly wired remote
# embedding backend would also receive document chunks. Use a local Ollama/LM Studio endpoint when
# prompts must stay on infrastructure you control. Runtime credentials are persisted unencrypted
# in local SQLite; see docs/deploy.md "Data flow and trust boundaries".

# --- Runtime ---
TRPG_LOCALE=en
TRPG_DATA_DIR=./data
TRPG_ENABLE_VECTOR_DB=true

# --- Iroh session / media limits (`python -m app --serve`) ---
# Seconds an unauthenticated connection has to send its `join` frame before the server closes
# it (blocks connection-exhaustion from peers that open a socket and never authenticate).
TRPG_TUI__JOIN_TIMEOUT=10

# --- Content moderation (gateway/ops.py Censor) ---
# OFF by default: Loreweaver ships NO built-in wordlist. Set ONE of these to turn it on. It
# currently only screens the AI Keeper's OWN narration (not player input) -- see docs/deploy.md
# "Content moderation" before relying on this for anything beyond a light guardrail.
# TRPG_CENSOR__WORDLIST_PATH=/path/to/wordlist.json   # {"word": level, ...}; level 1-5, see CensorLevel
# TRPG_CENSOR__WORDLIST=slur1:5,slur2:4                # inline word[:level],word2[:level2],... (no file needed)

# Or reverse WebSocket (the implementation connects to Loreweaver):
# TRPG_ONEBOT__MODE=reverse
# TRPG_ONEBOT__LISTEN_HOST=127.0.0.1
# TRPG_ONEBOT__LISTEN_PORT=6700
# TRPG_ONEBOT__PATH=/onebot/v11/ws

# --- Rate limits ------------------------------------------------------------
# Not configurable, but worth knowing: every provider path retries a 429/overloaded
# response with bounded, jittered backoff (infra/llm_retry.py). A throttled turn gets
# SLOWER, never dead — watch the server log for "LLM throttled" lines. If you see them
# often, the table is outrunning your plan's rate limit: give the Scribe (and, if you
# run one, the Director) their own smaller model below rather than sharing the main key.

# --- Post-turn bookkeeping Scribe (agent/scribe.py, 书记官) -------------------
# ON by default: one extra LLM call after each AI-KP turn reconciles module
# trackers and leaves keeper-side reminders. STRONGLY recommended: point it at a
# small/cheap model — blank fields reuse the main TRPG_LLM__* client (correct,
# but flagship prices for ledger work).
# TRPG_SCRIBE__ENABLED=1
# TRPG_SCRIBE__PROVIDER=deepseek
# TRPG_SCRIBE__CHAT_MODEL=deepseek-v4-flash
# TRPG_SCRIBE__API_KEY=sk-...
# TRPG_SCRIBE__REASONING_EFFORT=low

# --- Stage Director (agent/stage_director.py, 演出导演) ----------------------
# The player-side presentation actor: on story BEATS (the Scribe's 场记 lane spots
# them) it decides what the table sees and hears — act cards, letters, newspaper
# clippings, audio cues, generated art. Unlike the Scribe it defaults to the MAIN
# model: beats are rare and presentation is a taste judgment.
#
# It only ever runs for a room whose enabled module ships a presentation kit
# (`ui/presentation.yaml`), so a table with no such module is never charged for it.
# TRPG_DIRECTOR__ENABLED=1
# TRPG_DIRECTOR__PROVIDER=
# TRPG_DIRECTOR__CHAT_MODEL=
# TRPG_DIRECTOR__API_KEY=
# TRPG_DIRECTOR__REASONING_EFFORT=
# Image generation needs ALL THREE to agree: this switch, a configured
# TRPG_IMAGEGEN__* endpoint, and the module's own kit (an author may declare
# `generation: pack_only` — that veto is theirs and nothing here overrides it).
# MAX_IMAGES is a per-ROOM lifetime cap; past it the Director keeps staging with
# pack art and already-generated subjects and simply stops spending.
# TRPG_DIRECTOR__IMAGES=1
# TRPG_DIRECTOR__MAX_IMAGES=24
# TRPG_DIRECTOR__PREGEN_PER_BEAT=2

# --- Campaign chronicle (agent/chronicle.py, 战役编年史, M18) -----------------
# ON by default. When the assembled prompt's fullness (the room's usage meter)
# reaches FOLD_TRIGGER of the model's context window, the oldest chronicle
# records fold into the rolling campaign summary in batches until the FLOOR
# projection; FOLD_EMERGENCY forces a fold before the next model call. Ratios,
# not absolute tokens — every window size behaves uniformly. The last LAG_TURNS
# turns always stay raw (the no-future guard). The fold reuses the main
# TRPG_LLM__* client.
# TRPG_CHRONICLE__ENABLED=1
# TRPG_CHRONICLE__FOLD_TRIGGER=0.60
# TRPG_CHRONICLE__FOLD_FLOOR=0.40
# TRPG_CHRONICLE__FOLD_EMERGENCY=0.85
# TRPG_CHRONICLE__LAG_TURNS=4
# TRPG_CHRONICLE__SUMMARY_MAX_CHARS=4000
