# Loreweaver 3.0 server settings. Copy this file to `.env` at the root of the checkout: Bun reads
# `.env` from the directory the server starts in (`bun server/src/cli/main.ts serve`, or the
# terminal client's "Host locally & play"). Every variable the server reads is listed here, with
# its default; `server/src/infra/config.ts` is the only place that reads them. A value the server
# cannot use stops it at start-up, naming every bad variable at once. Unset and empty are the same.
#
# PRIVACY BOUNDARY: a remote model receives the Keeper's prompt (keeper-only lore included),
# relevant history and the current player input; an embedding endpoint, if you configure one,
# receives lore entries and chronicle lines. Use a local OpenAI-compatible endpoint when that must
# stay on infrastructure you control. API keys an admin sets at run time (`.model`, `.imagegen`)
# are stored unencrypted in the data directory's database; see docs/deploy.md.

# --- Server ------------------------------------------------------------------
# The language of rooms until a room sets its own: en | zh.
TRPG_LOCALE=en
# The data directory: database, key file, server identity, media, installed packs.
TRPG_DATA_DIR=./data

# --- The Keeper's model --------------------------------------------------------
# No model: the server still starts (note `model_not_configured`); the Keeper cannot answer until
# one is set here or by a room admin at run time (`.model set`, or the Model screen).
# Presets: openai, anthropic, deepseek, openrouter, moonshot. Any other name needs BASE_URL.
TRPG_LLM__PROVIDER=deepseek
TRPG_LLM__API_KEY=sk-...
# A capable Keeper matters: strong models run the module's own scenes and roll dice through the
# tools; budget models drift off-module and narrate without rolling.
TRPG_LLM__CHAT_MODEL=deepseek-v4-pro
# Wins over the preset's address; with a name of your own it is required.
# TRPG_LLM__BASE_URL=https://proxy.example/v1
# openai-compatible (Chat Completions) | anthropic (Messages API) | openai-responses.
# Default: the preset's, else openai-compatible.
# TRPG_LLM__WIRE=openai-compatible
# low | medium | high | xhigh | max. Unset: the provider's default.
TRPG_LLM__REASONING_EFFORT=max
# The model's context window in tokens. Unset: the server's verified figure for a model it knows,
# else 32000 is assumed (note `context_window_unknown`). This number is what the chronicle fold
# measures against, so set it for any model the server does not know.
# TRPG_LLM__CONTEXT_WINDOW=1000000
# A cap on one reply, in tokens. Unset: the provider's.
# TRPG_LLM__MAX_OUTPUT_TOKENS=
# How long one model call may take, in milliseconds. Unset: the SDK's.
# TRPG_LLM__TIMEOUT_MS=
# false: the OpenAI wires do not send `prompt_cache_key` (for an endpoint that rejects it).
# TRPG_LLM__PROMPT_CACHE_KEY=true
# --- The other model lanes ----------------------------------------------------
# Each lane takes the Keeper's ten fields under its own prefix. Unset: the lane uses the Keeper's
# client. A lane that names only a model (or an effort, a window, a cap, a timeout) keeps the
# Keeper's endpoint and key; one that names a PROVIDER or a BASE_URL is a separate endpoint and
# brings its own API_KEY.
#
# NPCs: each NPC the Keeper gives its own voice (it sees only that NPC's record).
# TRPG_NPC__PROVIDER=
# TRPG_NPC__BASE_URL=
# TRPG_NPC__API_KEY=
# TRPG_NPC__CHAT_MODEL=
# TRPG_NPC__WIRE=
# TRPG_NPC__REASONING_EFFORT=
# TRPG_NPC__CONTEXT_WINDOW=
# TRPG_NPC__MAX_OUTPUT_TOKENS=
# TRPG_NPC__TIMEOUT_MS=
# TRPG_NPC__PROMPT_CACHE_KEY=
#
# the Scribe: one call after every Keeper turn. Point it at a small, cheap model.
# TRPG_SCRIBE__PROVIDER=
# TRPG_SCRIBE__BASE_URL=
# TRPG_SCRIBE__API_KEY=
# TRPG_SCRIBE__CHAT_MODEL=
# TRPG_SCRIBE__WIRE=
# TRPG_SCRIBE__REASONING_EFFORT=
# TRPG_SCRIBE__CONTEXT_WINDOW=
# TRPG_SCRIBE__MAX_OUTPUT_TOKENS=
# TRPG_SCRIBE__TIMEOUT_MS=
# TRPG_SCRIBE__PROMPT_CACHE_KEY=
#
# the Stage Director: on story beats only. The Keeper's model is the right default.
# TRPG_DIRECTOR__PROVIDER=
# TRPG_DIRECTOR__BASE_URL=
# TRPG_DIRECTOR__API_KEY=
# TRPG_DIRECTOR__CHAT_MODEL=
# TRPG_DIRECTOR__WIRE=
# TRPG_DIRECTOR__REASONING_EFFORT=
# TRPG_DIRECTOR__CONTEXT_WINDOW=
# TRPG_DIRECTOR__MAX_OUTPUT_TOKENS=
# TRPG_DIRECTOR__TIMEOUT_MS=
# TRPG_DIRECTOR__PROMPT_CACHE_KEY=
#
# the chronicle fold.
# TRPG_MEMORY__PROVIDER=
# TRPG_MEMORY__BASE_URL=
# TRPG_MEMORY__API_KEY=
# TRPG_MEMORY__CHAT_MODEL=
# TRPG_MEMORY__WIRE=
# TRPG_MEMORY__REASONING_EFFORT=
# TRPG_MEMORY__CONTEXT_WINDOW=
# TRPG_MEMORY__MAX_OUTPUT_TOKENS=
# TRPG_MEMORY__TIMEOUT_MS=
# TRPG_MEMORY__PROMPT_CACHE_KEY=

# --- The Keeper's turn -----------------------------------------------------------
# Tool rounds the Keeper may take in one turn before it must answer.
# TRPG_TURN__MAX_ROUNDS=12

# --- The Scribe (书记官) ----------------------------------------------------------
# On by default: one extra model call after each Keeper turn reconciles the trackers against the
# narration, leaves the Keeper reminders for its next turn, and writes the chronicle line.
# Give it its own small model under TRPG_SCRIBE__* above (unset: flagship prices for ledger work).
# TRPG_SCRIBE__ENABLED=true

# --- The Stage Director (演出导演) -------------------------------------------------
# Runs only in a room that enabled a pack with a presentation kit, and only on story beats.
# TRPG_DIRECTOR__ENABLED=true
# false: the Director shows a pack's pictures but never generates one. Generating also needs an
# image endpoint (below, or `.imagegen set`) and a kit that does not say `generation: pack_only`.
# TRPG_DIRECTOR__IMAGES=true
# Pictures one story may generate; past it the Director stages with pictures it already has.
# TRPG_DIRECTOR__MAX_IMAGES=24
# Likely-next subjects one beat may ask to prepare.
# TRPG_DIRECTOR__PREGEN_PER_BEAT=2

# --- Campaign chronicle (战役编年史) -----------------------------------------------
# When the prompt reaches FOLD_TRIGGER of the context window, the oldest chronicle records fold
# into the rolling campaign summary until it is under FOLD_FLOOR; FOLD_EMERGENCY forces a fold
# before the next model call. Fractions, floor < trigger <= emergency. The last LAG_TURNS turns
# always stay raw.
# TRPG_CHRONICLE__ENABLED=true
# TRPG_CHRONICLE__FOLD_TRIGGER=0.60
# TRPG_CHRONICLE__FOLD_FLOOR=0.40
# TRPG_CHRONICLE__FOLD_EMERGENCY=0.85
# TRPG_CHRONICLE__LAG_TURNS=4
# TRPG_CHRONICLE__SUMMARY_MAX_CHARS=4000

# --- Image generation ------------------------------------------------------------
# Off unless set. BASE_URL, API_KEY and MODEL go together; there is no default model.
# TRPG_IMAGEGEN__BASE_URL=https://api.openai.com/v1
# TRPG_IMAGEGEN__API_KEY=
# TRPG_IMAGEGEN__MODEL=
# WIDTHxHEIGHT or auto.
# TRPG_IMAGEGEN__SIZE=1024x1024
# openai | xai.
# TRPG_IMAGEGEN__DIALECT=openai

# --- Recall by meaning (embeddings) ---------------------------------------------------
# Off unless set (note `recall_off`): lore then activates by keyword only. An OpenAI-compatible
# embeddings endpoint; API_KEY, MODEL and DIMENSIONS go together. BASE_URL unset: OpenAI's.
# TRPG_EMBEDDINGS__BASE_URL=
# TRPG_EMBEDDINGS__API_KEY=
# TRPG_EMBEDDINGS__MODEL=text-embedding-3-small
# TRPG_EMBEDDINGS__DIMENSIONS=1536

# --- Word filter -------------------------------------------------------------------
# OFF by default: Loreweaver ships NO word list. It screens the Keeper's narration, a module's
# table facts and model-written character text, not player input; see docs/deploy.md "Content
# moderation" before relying on it. Inline `word[:level],...`, and/or a file with one
# `word[:level]` per line (an unreadable file stops the server). Levels 1-5; 4 and up block.
# TRPG_CENSOR__WORDLIST=slur1:5,slur2:4
# TRPG_CENSOR__WORDLIST_PATH=/path/to/wordlist.txt

# --- Undo -------------------------------------------------------------------------
# How many turns back `.undo` may reach.
# TRPG_STORE__UNDO_DEPTH=4

# --- Modules -----------------------------------------------------------------------
# How long one call into a room's module worker may take, in milliseconds, before the worker is
# ended.
# TRPG_MODULES__CALL_TIMEOUT_MS=5000

# --- Sounds --------------------------------------------------------------------------
# One sound, and all of a room's sounds together, in bytes (128 MiB and 2 GiB).
# TRPG_TUI__AUDIO_MAX_FILE_BYTES=134217728
# TRPG_TUI__AUDIO_ROOM_QUOTA_BYTES=2147483648
